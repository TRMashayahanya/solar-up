# Copy this file to ".env" and edit the password below.
# Then run ./start.sh — no coding needed.

PORT=5173

# Your private admin password (for https://yoursite/admin/ only — never share publicly)
ADMIN_API_KEY=Pick-A-Long-Password-Only-You-Know

# Optional — Google Maps + global place search on the quote page (restrict key to your domain in Google Cloud)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
